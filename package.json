{
  "name": "dust-compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A free, offline-first map, event guide, and compass for the playa",
  "scripts": {
    "dev": "next dev",
    "build": "npm run icons && npm run verify:icons && npm run og && npm run verify:og && npm run share-cards && npm run prepare:map-worker && next build && npm run verify:og:export && node scripts/build-sw.mjs",
    "preview": "node scripts/serve-export.mjs",
    "typecheck": "tsc --noEmit",
    "verify:og": "metaplate verify --size 1200x630 public/og-image.png",
    "verify:og:export": "metaplate verify --size 1200x630 out/og-image.png",
    "prepare:map-worker": "node scripts/copy-map-worker.mjs",
    "fetch-data": "node scripts/fetch-data.mjs",
    "fetch-archive": "node scripts/fetch-archive.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify:icons": "node scripts/check-icons.mjs",
    "test:a11y": "node scripts/a11y-test.mjs",
    "test:ui": "node scripts/ui-invariants.mjs",
    "fetch-api": "node scripts/fetch-api.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "og": "node scripts/make-og.mjs",
    "share-cards": "node scripts/make-poi-cards.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@turf/turf": "^7.4.0",
    "@vis.gl/react-maplibre": "^8.1.2",
    "maplibre-gl": "^6.5.0",
    "metaplate": "^0.5.0",
    "next": "^16.3.2",
    "pmtiles": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "satori": "^0.33.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
